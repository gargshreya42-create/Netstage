# === NetSage AI Backend Environment Configuration ===
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file with real credentials.

# LLM provider API key (required for AI diagnosis features).
# NetSage AI runs fully in "offline mode" (rule-checker only) if this is left blank.
OPENAI_API_KEY=

# Model name used for diagnosis calls.
AI_MODEL=gpt-4o-mini

# Database connection string.
# Default uses local SQLite file; can be swapped for PostgreSQL later, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/netsage
DATABASE_URL=sqlite:///./netsage.db

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App environment: development | production
APP_ENV=development
